# P2D Docker Environment Configuration
# このファイルを .env にコピーして使用してください
# cp .env.example .env
#
# 重要 (監査#2): TURN_USER / TURN_PASS / TURN_EXTERNAL_IP に既定値はありません。
# 未設定のまま起動すると docker-compose が失敗します (意図的な挙動)。

# ========================================
# TURN Server Settings (必須)
# ========================================

# TURN認証情報 (必須。必ず強力な値に変更すること)
TURN_USER=change_me
TURN_PASS=change_me_to_a_long_random_string

# TURNサーバーのRealm
TURN_REALM=p2d.local

# 外部IPアドレス (必須。coturn の --external-ip に渡される)
# NAT配下/VPS: グローバルIP  例: TURN_EXTERNAL_IP=203.0.113.100
# 自宅LAN: そのホストのプライベートIP  例: TURN_EXTERNAL_IP=192.168.1.20
TURN_EXTERNAL_IP=

# ========================================
# ルーム参加者数の上限 (任意)
# ========================================
# 未設定時は8。Full Meshの帯域・接続数は参加者数に対して急増するため
# 用途に合わせて調整すること (目安は DOCKER.md の「サポート規模」節)
#P2D_MAX_PARTICIPANTS=8

# ========================================
# 公開環境用 TLS (docker-compose.tls.yml 使用時のみ必須)
# ========================================
# wss:// の終端に使うドメイン (Let's Encrypt で証明書を自動取得)
#CADDY_DOMAIN=p2d.example.com

# ========================================
# クライアント設定例 (P2Dアプリ内)
# ========================================
#
# LAN (暗号化なし・信頼できる網内のみ):
#   Signaling URL: ws://YOUR_SERVER_IP:8080
#   TURN URL: turn:YOUR_SERVER_IP:3478
#
# 公開環境 (TLS必須):
#   Signaling URL: wss://p2d.example.com
#   TURN URL: turns:p2d.example.com:5349
#
# Username: ${TURN_USER}
# Credential: ${TURN_PASS}
